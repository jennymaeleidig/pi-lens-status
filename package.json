{
  "name": "pi-lens-status",
  "version": "0.0.0",
  "private": true,
  "description": "Show pi-lens's LSP status in a Zentui Minimalist border slot",
  "type": "module",
  "license": "CC0-1.0",
  "keywords": [
    "pi-package",
    "pi-extension",
    "lsp",
    "pi-lens",
    "zentui",
    "status"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jennymaeleidig/pi-lens-status.git"
  },
  "homepage": "https://github.com/jennymaeleidig/pi-lens-status#readme",
  "bugs": {
    "url": "https://github.com/jennymaeleidig/pi-lens-status/issues"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "GLOSSARY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
